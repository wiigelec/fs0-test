#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
os.environ["PYTHONDONTWRITEBYTECODE"] = "1"


def repository_root() -> Path:
    root = Path.cwd().resolve()
    if not (root / ".git").exists() or not (root / "repo/conformance/run.py").is_file():
        print("repo/scripts/validate must be invoked from repository root", file=sys.stderr)
        raise SystemExit(2)
    return root


def run_engine(root: Path):
    env = os.environ.copy()
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    proc = subprocess.run(
        [sys.executable, "-B", str(root / "repo/conformance/run.py")],
        cwd=root,
        text=True,
        capture_output=True,
        env=env,
    )
    if proc.stderr:
        print(proc.stderr, end="", file=sys.stderr)
    try:
        report = json.loads(proc.stdout)
    except json.JSONDecodeError:
        if proc.stdout:
            print(proc.stdout, end="")
        print("Conformance engine did not produce a valid structured result", file=sys.stderr)
        raise SystemExit(proc.returncode if proc.returncode else 1)
    return proc.returncode, report, proc.stdout


def status_label(report):
    status = report.get("status")
    return {
        "pass": "PASS",
        "fail": "FAILED",
        "incomplete": "INCOMPLETE",
    }.get(status, str(status).upper())


def counts(report):
    passed = int(report.get("passed_assertions", 0))
    failed = len(report.get("failed_assertions", []))
    pending = len(report.get("pending_assertions", []))
    return passed, failed, pending


def print_summary(report):
    passed, failed, pending = counts(report)
    print(f"FS0 Conformance: {status_label(report)}")
    print()
    print(f"Passed:  {passed}")
    print(f"Failed:  {failed}")
    print(f"Pending: {pending}")

    failed_ids = report.get("failed_assertions", [])
    result_by_id = {r.get("assertion_id"): r for r in report.get("results", [])}

    if failed_ids:
        print()
        print("Failed assertions:")
        for aid in failed_ids:
            item = result_by_id.get(aid, {})
            print(f"  {aid}")
            detail = item.get("detail")
            if detail:
                print(f"    {detail}")
    elif pending:
        print()
        print("No realized assertions failed.")

    if failed_ids or pending:
        print()
        print("Run:")
        print("  repo/scripts/validate --verbose   show assertion details")
        print("  repo/scripts/validate --json      emit full structured result")


def print_verbose(report):
    print_summary(report)

    results = report.get("results", [])
    pending = report.get("pending_assertions", [])

    if results:
        print()
        print("Realized assertions:")
        for item in results:
            aid = item.get("assertion_id", "<unknown>")
            state = str(item.get("status", "unknown")).upper()
            print(f"  [{state}] {aid}")
            detail = item.get("detail")
            if detail:
                print(f"         {detail}")

    if pending:
        print()
        print("Pending assertions:")
        for aid in pending:
            print(f"  [PENDING] {aid}")


def main():
    parser = argparse.ArgumentParser(
        prog="repo/scripts/validate",
        description="Run FS0 Conformance validation.",
    )
    group = parser.add_mutually_exclusive_group()
    group.add_argument(
        "--verbose",
        action="store_true",
        help="show realized and pending assertion details",
    )
    group.add_argument(
        "--json",
        action="store_true",
        help="emit the complete structured Conformance result",
    )
    args = parser.parse_args()

    root = repository_root()
    code, report, raw = run_engine(root)

    if args.json:
        print(raw, end="" if raw.endswith("\n") else "\n")
    elif args.verbose:
        print_verbose(report)
    else:
        print_summary(report)

    return code


if __name__ == "__main__":
    raise SystemExit(main())
