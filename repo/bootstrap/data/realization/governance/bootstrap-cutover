#!/usr/bin/env python3
from pathlib import Path
import os
import sys

root = Path.cwd().resolve()
target = root / "repo/governance/bootstrap_cutover.py"
if not target.is_file():
    raise SystemExit("repo/governance/bootstrap_cutover.py is missing")
os.execv(sys.executable, [sys.executable, str(target), *sys.argv[1:]])
